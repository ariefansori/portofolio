  "sectionContents": {
    "about": {
      "title": "PIT STOP 1 - DRIVER PROFILE & ABOUT ME",
      "icon": "fa-user-astronaut",
      "html": "<div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 items-center\"><div class=\"flex flex-col items-center text-center bg-gray-800 p-4 rounded-lg border-2 border-yellow-500/50\"><img src=\"https://avatars.githubusercontent.com/u/1605785?s=400&u=43cc8620fdc8466e5f6af98c85c23cd7f9ff7011&v=4\" alt=\"Driver Avatar\" class=\"w-32 h-32 rounded-full border-4 border-yellow-400 shadow-md mb-3 object-cover\"><h3 class=\"font-pixel text-yellow-400 text-sm\">ASA 'RACER' DEV</h3><p class=\"text-xs text-gray-400 font-pixel mt-1\">Full-Stack & Game Engineer</p></div><div class=\"md:col-span-2 space-y-4\"><p class=\"text-xl leading-relaxed\">Welcome to my pit lane! I am a <span class=\"text-yellow-400 font-bold\">Full-Stack Engineer</span> passionate about crafting ultra-responsive web applications, interactive canvas experiences, and arcade physics engines.</p><p class=\"text-base text-gray-300\">Specializing in JavaScript/TypeScript ecosystems, web audio synthesis, performance optimization, and clean retro pixel aesthetic design.</p><div class=\"grid grid-cols-2 gap-3 font-pixel text-xs pt-2\"><div class=\"bg-black/50 p-2 rounded border border-gray-700\"><span class=\"text-gray-400\">EXPERIENCE:</span> <span class=\"text-yellow-400\">6+ YEARS</span></div><div class=\"bg-black/50 p-2 rounded border border-gray-700\"><span class=\"text-gray-400\">STATUS:</span> <span class=\"text-green-400\">AVAILABLE</span></div></div></div></div>"
    },
    "projects": {
      "title": "PIT STOP 2 - GARAGE SHOWROOM & PROJECTS",
      "icon": "fa-code-branch",
      "html": "<div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div class=\"bg-gray-800 p-4 rounded-lg border border-blue-500/40 hover:border-blue-400 transition flex flex-col justify-between\"><div><div class=\"flex justify-between items-start mb-2\"><h4 class=\"font-pixel text-blue-400 text-sm\">CYBER TANK 3D</h4><span class=\"bg-blue-900/80 text-blue-300 font-pixel text-[10px] px-2 py-0.5 rounded\">Three.js</span></div><p class=\"text-sm text-gray-300 mb-3\">A WebGL 3D multiplayer tank game built with Three.js and WebSockets for real-time arcade battles.</p></div><div class=\"flex justify-end pt-2 border-t border-gray-700\"><button onclick=\"alert('Launching Cyber Tank Demo!')\" class=\"bg-blue-600 hover:bg-blue-500 text-white font-pixel text-[10px] px-3 py-1.5 rounded transition\">DEMO</button></div></div><div class=\"bg-gray-800 p-4 rounded-lg border border-purple-500/40 hover:border-purple-400 transition flex flex-col justify-between\"><div><div class=\"flex justify-between items-start mb-2\"><h4 class=\"font-pixel text-purple-400 text-sm\">DEV DASHBOARD AI</h4><span class=\"bg-purple-900/80 text-purple-300 font-pixel text-[10px] px-2 py-0.5 rounded\">React / Tailwind</span></div><p class=\"text-sm text-gray-300 mb-3\">AI-powered analytics suite for software engineering teams to monitor velocity and code quality.</p></div><div class=\"flex justify-end pt-2 border-t border-gray-700\"><button onclick=\"alert('Viewing Dashboard Source!')\" class=\"bg-purple-600 hover:bg-purple-500 text-white font-pixel text-[10px] px-3 py-1.5 rounded transition\">GITHUB</button></div></div><div class=\"bg-gray-800 p-4 rounded-lg border border-green-500/40 hover:border-green-400 transition flex flex-col justify-between\"><div><div class=\"flex justify-between items-start mb-2\"><h4 class=\"font-pixel text-green-400 text-sm\">GENERALLY PORTFOLIO</h4><span class=\"bg-green-900/80 text-green-300 font-pixel text-[10px] px-2 py-0.5 rounded\">Canvas / Audio</span></div><p class=\"text-sm text-gray-300 mb-3\">Retro top-down racing interactive portfolio with animated pit crew and procedural audio synth engine.</p></div><div class=\"flex justify-end pt-2 border-t border-gray-700\"><button onclick=\"alert('You are currently driving in it!')\" class=\"bg-green-600 hover:bg-green-500 text-white font-pixel text-[10px] px-3 py-1.5 rounded transition\">ACTIVE</button></div></div><div class=\"bg-gray-800 p-4 rounded-lg border border-yellow-500/40 hover:border-yellow-400 transition flex flex-col justify-between\"><div><div class=\"flex justify-between items-start mb-2\"><h4 class=\"font-pixel text-yellow-400 text-sm\">RETRO STORE API</h4><span class=\"bg-yellow-900/80 text-yellow-300 font-pixel text-[10px] px-2 py-0.5 rounded\">Node / Go</span></div><p class=\"text-sm text-gray-300 mb-3\">High-throughput microservices backend handling digital asset trading and authentication.</p></div><div class=\"flex justify-end pt-2 border-t border-gray-700\"><button onclick=\"alert('API Docs Loaded!')\" class=\"bg-yellow-600 hover:bg-yellow-500 text-white font-pixel text-[10px] px-3 py-1.5 rounded transition\">DOCS</button></div></div></div>"
    },
